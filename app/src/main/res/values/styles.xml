<resources>
    <style name="Theme.VeritasReader" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="Theme.VeritasPdfViewer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#11161A</item>
        <item name="android:statusBarColor">#11161A</item>

        <item name="colorPrimary">#78DDE8</item>
        <item name="colorPrimaryContainer">#153B42</item>
        <item name="colorOnPrimaryContainer">#E8FAFD</item>
        <item name="colorPrimaryFixedDim">#7EDAE6</item>
        <item name="colorSecondaryContainer">#263F46</item>
        <item name="colorTertiaryFixed">#D5EBAE</item>
        <item name="colorSurfaceBright">#2A3338</item>
        <item name="colorSurfaceContainer">#1B2227</item>
        <item name="colorSurfaceContainerHigh">#232B30</item>
        <item name="colorOnSurface">#F7FAFC</item>
        <item name="colorOnSurfaceVariant">#CED8DF</item>

        <item name="textAppearanceBodyMedium">@style/TextAppearance.VeritasPdfViewer.BodyMedium</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.VeritasPdfViewer.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.VeritasPdfViewer.TitleSmall</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.VeritasPdfViewer.LabelMedium</item>
    </style>

    <style name="TextAppearance.VeritasPdfViewer.BodyMedium" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.VeritasPdfViewer.TitleMedium" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.VeritasPdfViewer.TitleSmall" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.VeritasPdfViewer.LabelMedium" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Theme.Veritas.TranslucentDialog" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>
</resources>
