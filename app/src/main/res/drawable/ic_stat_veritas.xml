<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome status-bar icon: the Veritas "V" mark, drawn as a stroked chevron
     with round caps/joins so the corners are rounded like the app icon. Android tints
     small icons, so only this white silhouette is used. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M4.9,5 L12,18 L19.1,5" />
</vector>
