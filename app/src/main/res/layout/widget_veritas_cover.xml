<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cover_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_veritas_background">

    <ImageView
        android:id="@+id/widget_cover_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:alpha="1"
        android:background="@drawable/widget_veritas_circle_background"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/veritas_reader_icon" />

    <TextView
        android:id="@+id/widget_cover_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:ellipsize="end"
        android:maxLines="2"
        android:padding="12dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_cover_play"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:background="@drawable/widget_veritas_button"
        android:gravity="center"
        android:text="@string/widget_play"
        android:textColor="#FF101418"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_cover_favorite"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/widget_veritas_button_soft"
        android:gravity="center"
        android:text="@string/widget_favorite"
        android:textColor="#FF303822"
        android:textSize="25sp"
        android:textStyle="bold" />
</FrameLayout>
